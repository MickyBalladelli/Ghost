{
  "name": "ghostpilot-ai",
  "displayName": "GhostPilot AI",
  "description": "Local, offline Copilot & Codex alternative powered by Ollama/vLLM",
  "version": "1.0.12",
  "publisher": "ghostpilot",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ghostpilot-ai/ghostpilot-ai"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onCommand:ghostpilot-ai.helloWorld",
    "onCommand:ghostpilot.checkOllamaStatus",
    "onCommand:ghostpilot.toggleInline",
    "onCommand:ghostpilot.checkModels",
    "onCommand:ghostpilot.open",
    "onCommand:ghostpilot.focus",
    "onCommand:ghostpilot.reset",
    "onCommand:ghostpilot.export",
    "onCommand:ghostpilot.clear",
    "onView:ghostpilot.chat",
    "onChatParticipant:ghostpilot.agent",
    "onLanguageModelTool:ghostpilot_read_file",
    "onLanguageModelTool:ghostpilot_write_file",
    "onLanguageModelTool:ghostpilot_apply_edit",
    "onLanguageModelTool:ghostpilot_run_terminal_command",
    "onLanguageModelTool:ghostpilot_list_directory"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ghostpilot-ai.helloWorld",
        "title": "GhostPilot AI: Hello World"
      },
      {
        "command": "ghostpilot.checkOllamaStatus",
        "title": "GhostPilot: Check Ollama Connection"
      },
      {
        "command": "ghostpilot.toggleInline",
        "title": "GhostPilot: Toggle Autocomplete"
      },
      {
        "command": "ghostpilot.checkModels",
        "title": "GhostPilot: Check Required Models"
      },
      {
        "command": "ghostpilot.open",
        "title": "GhostPilot: Open Interface"
      },
      {
        "command": "ghostpilot.focus",
        "title": "GhostPilot: Focus Interface"
      },
      {
        "command": "ghostpilot.reset",
        "title": "GhostPilot: Reset Interface"
      },
      {
        "command": "ghostpilot.export",
        "title": "GhostPilot: Export Interface"
      },
      {
        "command": "ghostpilot.clear",
        "title": "GhostPilot: Clear Interface"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ghostpilot",
          "title": "GhostPilot",
          "icon": "./resources/ghostpilot.svg"
        }
      ]
    },
    "views": {
      "ghostpilot": [
        {
          "id": "ghostpilot.chat",
          "name": "GhostPilot",
          "type": "webview",
          "icon": "./resources/ghostpilot.svg",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "GhostPilot AI",
      "properties": {
        "ghostpilot.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama server URL."
        },
        "ghostpilot.openaiUrl": {
          "type": "string",
          "default": "http://localhost:8001/v1",
          "description": "OpenAI-compatible model server URL."
        },
        "ghostpilot.chatModel": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Model used for chat requests."
        },
        "ghostpilot.autocompleteModel": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b",
          "description": "Model used for inline code completions."
        },
        "ghostpilot.maxContextTokens": {
          "type": "integer",
          "default": 8192,
          "minimum": 1,
          "description": "Maximum number of context tokens sent to the model."
        },
        "ghostpilot.enableInlineCompletions": {
          "type": "boolean",
          "default": true,
          "description": "Enable GhostPilot inline code completions."
        },
        "ghostpilot.provider": {
          "type": "string",
          "enum": [
            "ollama",
            "mlx-vlm",
            "openai-compatible"
          ],
          "enumDescriptions": [
            "Use the Ollama API.",
            "Use an MLX VLM OpenAI-compatible server.",
            "Use another OpenAI-compatible server."
          ],
          "default": "ollama",
          "description": "GhostPilot model provider."
        },
        "ghostpilot.mlxUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "MLX VLM server URL."
        },
        "ghostpilot.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature for chat responses."
        },
        "ghostpilot.responseLength": {
          "type": "string",
          "enum": [
            "short",
            "balanced",
            "long",
            "unlimited"
          ],
          "default": "balanced",
          "description": "Default response length for the GhostPilot interface."
        },
        "ghostpilot.mode": {
          "type": "string",
          "enum": [
            "ask",
            "edit",
            "agent",
            "explain",
            "inline"
          ],
          "default": "ask",
          "description": "Default workflow mode for the GhostPilot interface."
        },
        "ghostpilot.enableConversationPersistence": {
          "type": "boolean",
          "default": false,
          "description": "Persist GhostPilot conversations and preferences in VS Code storage. Disable to keep chat history in memory only."
        },
        "ghostpilot.enableDebugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable telemetry-free GhostPilot debug logging in the extension host."
        },
        "ghostpilot.toolAllowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ghostpilot_read_file",
              "ghostpilot_write_file",
              "ghostpilot_apply_edit",
              "ghostpilot_run_terminal_command",
              "ghostpilot_list_directory"
            ]
          },
          "default": [
            "ghostpilot_read_file",
            "ghostpilot_write_file",
            "ghostpilot_apply_edit",
            "ghostpilot_run_terminal_command",
            "ghostpilot_list_directory"
          ],
          "description": "Tools GhostPilot may use. Workspace settings can restrict this list."
        },
        "ghostpilot.toolDenylist": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ghostpilot_read_file",
              "ghostpilot_write_file",
              "ghostpilot_apply_edit",
              "ghostpilot_run_terminal_command",
              "ghostpilot_list_directory"
            ]
          },
          "default": [],
          "description": "Tools GhostPilot must never use in this workspace."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "ghostpilot.agent",
        "name": "local",
        "description": "Local AI Agent (Ollama)",
        "isSticky": true
      }
    ],
    "languageModelTools": [
      {
        "name": "ghostpilot_read_file",
        "displayName": "GhostPilot Read File",
        "toolReferenceName": "ghostpilot_read_file",
        "userDescription": "Read a text file from the current workspace.",
        "modelDescription": "Reads the complete content of a text file in the current workspace. Use this for inspecting code or configuration. The path must be absolute and inside the workspace. Do not use it for binary files.",
        "canBeReferencedInPrompt": true,
        "icon": "$(file)",
        "when": "true",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path of the text file to read. The path must be inside the current workspace."
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "ghostpilot_write_file",
        "displayName": "GhostPilot Write File",
        "toolReferenceName": "ghostpilot_write_file",
        "userDescription": "Create or replace a text file in the current workspace.",
        "modelDescription": "Creates a new text file or replaces the complete content of an existing file in the current workspace. The path must be absolute and inside the workspace. This changes user files and requires confirmation.",
        "canBeReferencedInPrompt": true,
        "icon": "$(edit)",
        "when": "true",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path of the file to create or replace. The path must be inside the current workspace."
            },
            "content": {
              "type": "string",
              "description": "Complete UTF-8 text content to write to the file."
            }
          },
          "required": [
            "path",
            "content"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "ghostpilot_apply_edit",
        "displayName": "GhostPilot Apply Edit",
        "toolReferenceName": "ghostpilot_apply_edit",
        "userDescription": "Apply reviewed, structured edits inside the current workspace.",
        "modelDescription": "Proposes line-based edits to a workspace file. The user must approve the edit before it is applied. Paths must be absolute and inside the workspace.",
        "canBeReferencedInPrompt": true,
        "icon": "$(edit)",
        "when": "true",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute workspace file path."
            },
            "expectedContent": {
              "type": "string",
              "description": "Optional exact content expected before applying the edit."
            },
            "hunks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "startLine": { "type": "integer", "minimum": 1 },
                  "endLine": { "type": "integer", "minimum": 1 },
                  "replacement": { "type": "string" }
                },
                "required": ["startLine", "endLine", "replacement"],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 50
            }
          },
          "required": ["path", "hunks"],
          "additionalProperties": false
        }
      },
      {
        "name": "ghostpilot_run_terminal_command",
        "displayName": "GhostPilot Run Terminal Command",
        "toolReferenceName": "ghostpilot_run_terminal_command",
        "userDescription": "Run a shell command in the current workspace.",
        "modelDescription": "Runs a bash or PowerShell command in the current workspace and returns its output. Use only when the user asks for command execution or when it is needed to verify a change. Commands can change the system and require confirmation.",
        "canBeReferencedInPrompt": true,
        "icon": "$(terminal)",
        "when": "true",
        "inputSchema": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "description": "The bash or PowerShell command to run."
            },
            "cwd": {
              "type": "string",
              "description": "Optional absolute working directory inside the current workspace."
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "ghostpilot_list_directory",
        "displayName": "GhostPilot List Directory",
        "toolReferenceName": "ghostpilot_list_directory",
        "userDescription": "List files and directories in the current workspace.",
        "modelDescription": "Lists the file and directory hierarchy under a workspace directory. The path must be absolute and inside the current workspace. Use this to discover project structure before reading or editing files.",
        "canBeReferencedInPrompt": true,
        "icon": "$(folder)",
        "when": "true",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute directory path to list. The path must be inside the current workspace."
            },
            "recursive": {
              "type": "boolean",
              "description": "Whether to include nested directories.",
              "default": false
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --out ghostpilot-ai-1.0.12.vsix",
    "test": "npm run compile && node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.8.1",
    "mocha": "^11.8.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/node-fetch": "^2.6.13",
    "node-fetch": "^2.7.0"
  }
}
