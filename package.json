{
  "name": "ghost",
  "displayName": "Ghost",
  "description": "AI Coding Assistant powered by Ollama, MLX/VLM, and OpenAI-compatible model servers",
  "version": "1.0.25",
  "publisher": "ghost",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/MickyBalladelli/ghost"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onCommand:ghost.helloWorld",
    "onCommand:ghost.checkOllamaStatus",
    "onCommand:ghost.toggleInline",
    "onCommand:ghost.checkModels",
    "onCommand:ghost.open",
    "onCommand:ghost.focus",
    "onCommand:ghost.reset",
    "onCommand:ghost.export",
    "onCommand:ghost.clear",
    "onView:ghost.chat",
    "onChatParticipant:ghost.agent",
    "onLanguageModelTool:ghost_read_file",
    "onLanguageModelTool:ghost_write_file",
    "onLanguageModelTool:ghost_apply_edit",
    "onLanguageModelTool:ghost_run_terminal_command",
    "onLanguageModelTool:ghost_list_directory"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ghost.helloWorld",
        "title": "Ghost: Hello World"
      },
      {
        "command": "ghost.checkOllamaStatus",
        "title": "Ghost: Check Ollama Connection"
      },
      {
        "command": "ghost.toggleInline",
        "title": "Ghost: Toggle Autocomplete"
      },
      {
        "command": "ghost.checkModels",
        "title": "Ghost: Check Required Models"
      },
      {
        "command": "ghost.open",
        "title": "Ghost: Open Interface"
      },
      {
        "command": "ghost.focus",
        "title": "Ghost: Focus Interface"
      },
      {
        "command": "ghost.reset",
        "title": "Ghost: Reset Interface"
      },
      {
        "command": "ghost.export",
        "title": "Ghost: Export Interface"
      },
      {
        "command": "ghost.clear",
        "title": "Ghost: Clear Interface"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ghost",
          "title": "Ghost",
          "icon": "./resources/ghost.svg"
        }
      ]
    },
    "views": {
      "ghost": [
        {
          "id": "ghost.chat",
          "name": "Ghost",
          "type": "webview",
          "icon": "./resources/ghost.svg",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "Ghost",
      "properties": {
        "ghost.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama server URL."
        },
        "ghost.openaiUrl": {
          "type": "string",
          "default": "http://localhost:8001/v1",
          "description": "OpenAI-compatible model server URL."
        },
        "ghost.chatModel": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Model used for chat requests."
        },
        "ghost.autocompleteModel": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b",
          "description": "Model used for inline code completions."
        },
        "ghost.maxContextTokens": {
          "type": "integer",
          "default": 8192,
          "minimum": 1,
          "description": "Maximum number of context tokens sent to the model."
        },
        "ghost.enableInlineCompletions": {
          "type": "boolean",
          "default": true,
          "description": "Enable Ghost inline code completions."
        },
        "ghost.provider": {
          "type": "string",
          "enum": [
            "ollama",
            "mlx-vlm",
            "openai-compatible"
          ],
          "enumDescriptions": [
            "Use the Ollama API.",
            "Use an MLX VLM OpenAI-compatible server.",
            "Use another OpenAI-compatible server."
          ],
          "default": "ollama",
          "description": "Ghost model provider."
        },
        "ghost.mlxUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "MLX VLM server URL."
        },
        "ghost.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature for chat responses."
        },
        "ghost.responseLength": {
          "type": "string",
          "enum": [
            "short",
            "balanced",
            "long",
            "unlimited"
          ],
          "default": "balanced",
          "description": "Default response length for the Ghost interface."
        },
        "ghost.mode": {
          "type": "string",
          "enum": [
            "ask",
            "edit",
            "agent",
            "explain",
            "inline"
          ],
          "default": "ask",
          "description": "Default workflow mode for the Ghost interface."
        },
        "ghost.enableConversationPersistence": {
          "type": "boolean",
          "default": false,
          "description": "Persist Ghost conversations and preferences in VS Code storage. Disable to keep chat history in memory only."
        },
        "ghost.enableDebugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable telemetry-free Ghost debug logging in the extension host."
        },
        "ghost.toolAllowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ghost_read_file",
              "ghost_write_file",
              "ghost_apply_edit",
              "ghost_run_terminal_command",
              "ghost_list_directory"
            ]
          },
          "default": [
            "ghost_read_file",
            "ghost_write_file",
            "ghost_apply_edit",
            "ghost_run_terminal_command",
            "ghost_list_directory"
          ],
          "description": "Tools Ghost may use. Workspace settings can restrict this list."
        },
        "ghost.toolDenylist": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ghost_read_file",
              "ghost_write_file",
              "ghost_apply_edit",
              "ghost_run_terminal_command",
              "ghost_list_directory"
            ]
          },
          "default": [],
          "description": "Tools Ghost must never use in this workspace."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "ghost.agent",
        "name": "local",
        "description": "Local AI Agent (Ollama)",
        "isSticky": true
      }
    ],
    "languageModelTools": [
      {
        "name": "ghost_read_file",
        "displayName": "Ghost Read File",
        "toolReferenceName": "ghost_read_file",
        "userDescription": "Read a text file from the current workspace.",
        "modelDescription": "Reads the complete content of a text file in the current workspace. Use this for inspecting code or configuration. The path must be absolute and inside the workspace. Do not use it for binary files.",
        "canBeReferencedInPrompt": true,
        "icon": "$(file)",
        "when": "true",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path of the text file to read. The path must be inside the current workspace."
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "ghost_write_file",
        "displayName": "Ghost Write File",
        "toolReferenceName": "ghost_write_file",
        "userDescription": "Create or replace a text file in the current workspace.",
        "modelDescription": "Creates a new text file or replaces the complete content of an existing file in the current workspace. The path must be absolute and inside the workspace. This changes user files and requires confirmation.",
        "canBeReferencedInPrompt": true,
        "icon": "$(edit)",
        "when": "true",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path of the file to create or replace. The path must be inside the current workspace."
            },
            "content": {
              "type": "string",
              "description": "Complete UTF-8 text content to write to the file."
            }
          },
          "required": [
            "path",
            "content"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "ghost_apply_edit",
        "displayName": "Ghost Apply Edit",
        "toolReferenceName": "ghost_apply_edit",
        "userDescription": "Apply reviewed, structured edits inside the current workspace.",
        "modelDescription": "Proposes line-based edits to a workspace file. The user must approve the edit before it is applied. Paths must be absolute and inside the workspace.",
        "canBeReferencedInPrompt": true,
        "icon": "$(edit)",
        "when": "true",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute workspace file path."
            },
            "expectedContent": {
              "type": "string",
              "description": "Optional exact content expected before applying the edit."
            },
            "hunks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "startLine": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "endLine": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "replacement": {
                    "type": "string"
                  }
                },
                "required": [
                  "startLine",
                  "endLine",
                  "replacement"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 50
            }
          },
          "required": [
            "path",
            "hunks"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "ghost_run_terminal_command",
        "displayName": "Ghost Run Terminal Command",
        "toolReferenceName": "ghost_run_terminal_command",
        "userDescription": "Run a shell command in the current workspace.",
        "modelDescription": "Runs a bash or PowerShell command in the current workspace and returns its output. Use only when the user asks for command execution or when it is needed to verify a change. Commands can change the system and require confirmation.",
        "canBeReferencedInPrompt": true,
        "icon": "$(terminal)",
        "when": "true",
        "inputSchema": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "description": "The bash or PowerShell command to run."
            },
            "cwd": {
              "type": "string",
              "description": "Optional absolute working directory inside the current workspace."
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "ghost_list_directory",
        "displayName": "Ghost List Directory",
        "toolReferenceName": "ghost_list_directory",
        "userDescription": "List files and directories in the current workspace.",
        "modelDescription": "Lists the file and directory hierarchy under a workspace directory. The path must be absolute and inside the current workspace. Use this to discover project structure before reading or editing files.",
        "canBeReferencedInPrompt": true,
        "icon": "$(folder)",
        "when": "true",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute directory path to list. The path must be inside the current workspace."
            },
            "recursive": {
              "type": "boolean",
              "description": "Whether to include nested directories.",
              "default": false
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --out ghost-1.0.14.vsix",
    "test": "npm run compile && node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.8.1",
    "mocha": "^11.8.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/node-fetch": "^2.6.13",
    "node-fetch": "^2.7.0"
  }
}
