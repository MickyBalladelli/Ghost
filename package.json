{
  "name": "ghost-ai-coding-assistant",
  "displayName": "Ghost Coding Assistant",
  "description": "AI Coding Assistant powered by Ollama, MLX/VLM, and OpenAI-compatible model servers",
  "version": "1.0.86",
  "publisher": "MickyBalladelli",
  "author": {
    "name": "Micky Balladelli"
  },
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/MickyBalladelli/Ghost"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onCommand:ghost.helloWorld",
    "onCommand:ghost.checkOllamaStatus",
    "onCommand:ghost.toggleInline",
    "onCommand:ghost.checkModels",
    "onCommand:ghost.open",
    "onCommand:ghost.focus",
    "onCommand:ghost.reset",
    "onCommand:ghost.export",
    "onCommand:ghost.clear",
    "onView:ghost.chat",
    "onChatParticipant:ghost.agent",
    "onLanguageModelTool:ghost_read_file",
    "onLanguageModelTool:ghost_search_workspace",
    "onLanguageModelTool:ghost_write_file",
    "onLanguageModelTool:ghost_apply_edit",
    "onLanguageModelTool:ghost_apply_transaction",
    "onLanguageModelTool:ghost_run_terminal_command",
    "onLanguageModelTool:ghost_list_directory"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ghost.helloWorld",
        "title": "Ghost: Hello World"
      },
      {
        "command": "ghost.checkOllamaStatus",
        "title": "Ghost: Check Provider Connection"
      },
      {
        "command": "ghost.toggleInline",
        "title": "Ghost: Toggle Autocomplete"
      },
      {
        "command": "ghost.checkModels",
        "title": "Ghost: Check Required Models"
      },
      {
        "command": "ghost.setProviderApiKey",
        "title": "Ghost: Set Provider API Key"
      },
      {
        "command": "ghost.clearProviderApiKey",
        "title": "Ghost: Clear Provider API Key"
      },
      {
        "command": "ghost.open",
        "title": "Ghost: Open Interface"
      },
      {
        "command": "ghost.focus",
        "title": "Ghost: Focus Interface"
      },
      {
        "command": "ghost.reset",
        "title": "Ghost: Reset Interface"
      },
      {
        "command": "ghost.export",
        "title": "Ghost: Export Interface"
      },
      {
        "command": "ghost.clear",
        "title": "Ghost: Clear Interface"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ghost",
          "title": "Ghost",
          "icon": "./resources/ghost.svg"
        }
      ]
    },
    "views": {
      "ghost": [
        {
          "id": "ghost.chat",
          "name": "Ghost",
          "type": "webview",
          "icon": "./resources/ghost.svg",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "Ghost",
      "properties": {
        "ghost.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama server URL."
        },
        "ghost.openaiUrl": {
          "type": "string",
          "default": "http://localhost:8001/v1",
          "description": "OpenAI-compatible model server URL."
        },
        "ghost.chatModel": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Model used for chat requests."
        },
        "ghost.autocompleteModel": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b",
          "description": "Model used for inline code completions."
        },
        "ghost.maxContextTokens": {
          "type": "integer",
          "default": 8192,
          "minimum": 1,
          "description": "Maximum number of context tokens sent to the model."
        },
        "ghost.enableInlineCompletions": {
          "type": "boolean",
          "default": true,
          "description": "Enable Ghost inline code completions."
        },
        "ghost.provider": {
          "type": "string",
          "enum": [
            "ollama",
            "mlx-vlm",
            "openai-compatible"
          ],
          "enumDescriptions": [
            "Use the Ollama API.",
            "Use an MLX VLM OpenAI-compatible server.",
            "Use another OpenAI-compatible server."
          ],
          "default": "ollama",
          "description": "Ghost model provider."
        },
        "ghost.mlxUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "MLX VLM server URL."
        },
        "ghost.temperature": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature for chat responses."
        },
        "ghost.topP": {
          "type": "number",
          "default": 0.9,
          "minimum": 0,
          "maximum": 1,
          "description": "Nucleus sampling: keep tokens within this cumulative probability."
        },
        "ghost.topK": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "Keep only the top K likely tokens. Lower values are more focused."
        },
        "ghost.minP": {
          "type": "number",
          "default": 0.05,
          "minimum": 0,
          "maximum": 1,
          "description": "Discard tokens below this probability relative to the most likely token."
        },
        "ghost.presencePenalty": {
          "type": "number",
          "default": 0,
          "minimum": -2,
          "maximum": 2,
          "description": "Penalize tokens that already appeared. Positive values encourage new topics."
        },
        "ghost.repeatPenalty": {
          "type": "number",
          "default": 1.05,
          "minimum": 0,
          "maximum": 3,
          "description": "Penalize repeated text. Values above 1 penalize repetition more strongly."
        },
        "ghost.responseLength": {
          "type": "string",
          "enum": [
            "short",
            "balanced",
            "long",
            "unlimited"
          ],
          "default": "balanced",
          "description": "Default response length for the Ghost interface."
        },
        "ghost.mode": {
          "type": "string",
          "enum": [
            "ask",
            "edit",
            "agent",
            "explain",
            "inline"
          ],
          "default": "agent",
          "description": "Default workflow mode for the Ghost interface."
        },
        "ghost.fileEditApproval": {
          "type": "string",
          "enum": [
            "confirm",
            "auto"
          ],
          "enumDescriptions": [
            "Ask before applying each file write or edit.",
            "Apply file writes and edits without asking."
          ],
          "default": "confirm",
          "description": "Default approval behavior for Ghost file writes and structured edits."
        },
        "ghost.autoAcceptScope": {
          "type": "string",
          "enum": [
            "confirm",
            "one-edit",
            "current-file",
            "request",
            "session",
            "workspace",
            "always"
          ],
          "enumDescriptions": [
            "Ask before every file edit.",
            "Auto-accept one file edit, then ask again.",
            "Auto-accept edits to one file during the current request.",
            "Auto-accept file edits during the current request.",
            "Auto-accept file edits during this Ghost session.",
            "Auto-accept file edits in this workspace.",
            "Auto-accept file edits everywhere. Use with care."
          ],
          "default": "confirm",
          "description": "Scope for automatic file-edit approval. Terminal and other dangerous tools always require explicit approval."
        },
        "ghost.enableConversationPersistence": {
          "type": "boolean",
          "default": false,
          "description": "Persist Ghost conversations and preferences in VS Code storage. Disable to keep chat history in memory only."
        },
        "ghost.enableDebugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable telemetry-free Ghost debug logging in the extension host."
        },
        "ghost.toolAllowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ghost_read_file",
              "ghost_search_workspace",
              "ghost_write_file",
              "ghost_apply_edit",
              "ghost_apply_transaction",
              "ghost_run_terminal_command",
              "ghost_list_directory"
            ]
          },
          "default": [
            "ghost_read_file",
            "ghost_search_workspace",
            "ghost_write_file",
            "ghost_apply_edit",
            "ghost_apply_transaction",
            "ghost_run_terminal_command",
            "ghost_list_directory"
          ],
          "description": "Tools Ghost may use. Workspace settings can restrict this list."
        },
        "ghost.toolDenylist": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ghost_read_file",
              "ghost_search_workspace",
              "ghost_write_file",
              "ghost_apply_edit",
              "ghost_apply_transaction",
              "ghost_run_terminal_command",
              "ghost_list_directory"
            ]
          },
          "default": [],
          "description": "Tools Ghost must never use in this workspace."
        },
        "ghost.terminalEnvironmentAllowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "default": [
            "PATH",
            "HOME",
            "USER",
            "USERNAME",
            "SHELL",
            "ComSpec",
            "SystemRoot",
            "TMPDIR",
            "TMP",
            "TEMP",
            "LANG",
            "LC_ALL",
            "TERM",
            "CI",
            "PWD"
          ],
          "description": "Environment variable names allowed in Ghost terminal processes. Secret-looking names are always excluded."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "ghost.agent",
        "name": "local",
        "description": "Local AI Agent (Ollama)",
        "isSticky": true
      }
    ],
    "languageModelTools": [
      {
        "name": "ghost_search_workspace",
        "displayName": "Ghost Search Workspace",
        "toolReferenceName": "ghost_search_workspace",
        "userDescription": "Search text in the current workspace.",
        "modelDescription": "Searches workspace text with ripgrep and returns structured file, line, column, and matching-line data. Uses fixed-string search by default. The optional path must be inside the workspace.",
        "canBeReferencedInPrompt": true,
        "icon": "$(search)",
        "when": "true",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "description": "Text to search for. Fixed-string matching is used by default."
            },
            "path": {
              "type": "string",
              "description": "Optional workspace file or directory path to search."
            },
            "glob": {
              "type": "string",
              "description": "Optional ripgrep glob filter such as **/*.ts."
            },
            "caseSensitive": {
              "type": "boolean",
              "default": true
            },
            "maxResults": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 100
            }
          },
          "required": ["query"],
          "additionalProperties": false
        }
      },
      {
        "name": "ghost_read_file",
        "displayName": "Ghost Read File",
        "toolReferenceName": "ghost_read_file",
        "userDescription": "Read a text file from the current workspace.",
        "modelDescription": "Reads a text file in chunks from the current workspace. The path must be absolute and inside the workspace. For large files, use optional startLine and endLine and read every relevant chunk before editing. Do not use it for binary files.",
        "canBeReferencedInPrompt": true,
        "icon": "$(file)",
        "when": "true",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Absolute path of the text file to read. The path must be inside the current workspace."
            },
            "startLine": {
              "type": "integer",
              "minimum": 1,
              "description": "Optional first line to read. Use this to read a large file in chunks."
            },
            "endLine": {
              "type": "integer",
              "minimum": 1,
              "description": "Optional last line to read. Keep each read chunk to about 400 lines."
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "ghost_write_file",
        "displayName": "Ghost Write File",
        "toolReferenceName": "ghost_write_file",
        "userDescription": "Create or replace a text file in the current workspace.",
        "modelDescription": "Creates a new text file or replaces the complete content of an existing file in the current workspace. The path must be absolute and inside the workspace. This changes user files and requires confirmation.",
        "canBeReferencedInPrompt": true,
        "icon": "$(edit)",
        "when": "true",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Absolute path of the file to create or replace. The path must be inside the current workspace."
            },
            "content": {
              "type": "string",
              "description": "Complete UTF-8 text content to write to the file."
            }
          },
          "required": [
            "path",
            "content"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "ghost_apply_edit",
        "displayName": "Ghost Apply Edit",
        "toolReferenceName": "ghost_apply_edit",
        "userDescription": "Apply reviewed, structured edits inside the current workspace.",
        "modelDescription": "Proposes context-aware edits to a workspace file. Include oldText, oldHash, beforeContext, or afterContext in every hunk so line numbers are checked against current file content. The user must approve the edit before it is applied. Paths must be absolute and inside the workspace.",
        "canBeReferencedInPrompt": true,
        "icon": "$(edit)",
        "when": "true",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Absolute workspace file path."
            },
            "expectedContent": {
              "type": "string",
              "description": "Optional exact content expected before applying the edit."
            },
            "hunks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "startLine": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "endLine": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "replacement": {
                    "type": "string"
                  },
                  "oldText": {
                    "type": "string",
                    "description": "Optional exact text currently replaced by this hunk. Use it to detect shifted or stale line numbers."
                  },
                  "oldHash": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{64}$",
                    "description": "Optional SHA-256 hash of the current text replaced by this hunk."
                  },
                  "beforeContext": {
                    "type": "string",
                    "description": "Optional exact nearby text immediately before the hunk."
                  },
                  "afterContext": {
                    "type": "string",
                    "description": "Optional exact nearby text immediately after the hunk."
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "oldText"
                    ]
                  },
                  {
                    "required": [
                      "oldHash"
                    ]
                  },
                  {
                    "required": [
                      "beforeContext"
                    ]
                  },
                  {
                    "required": [
                      "afterContext"
                    ]
                  }
                ],
                "required": [
                  "startLine",
                  "endLine",
                  "replacement"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 50
            }
          },
          "required": [
            "path",
            "hunks"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "ghost_apply_transaction",
        "displayName": "Ghost Apply Transaction",
        "toolReferenceName": "ghost_apply_transaction",
        "userDescription": "Apply and verify multiple workspace file edits as one transaction.",
        "modelDescription": "Applies 2 to 50 workspace file edits together. Include one content or hunks edit per unique absolute path. Ghost previews the combined change, verifies every baseline, applies all files, verifies all results, and rolls the group back if any file fails.",
        "canBeReferencedInPrompt": true,
        "icon": "$(edit)",
        "when": "true",
        "inputSchema": {
          "type": "object",
          "properties": {
            "edits": {
              "type": "array",
              "minItems": 2,
              "maxItems": 50,
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Absolute workspace file path."
                  },
                  "content": {
                    "type": "string",
                    "description": "Complete replacement content. Use this or hunks, not both."
                  },
                  "expectedContent": {
                    "type": "string",
                    "description": "Optional exact content expected before applying this file edit."
                  },
                  "hunks": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50,
                    "items": {
                      "type": "object",
                      "properties": {
                        "startLine": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "endLine": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "replacement": {
                          "type": "string"
                        },
                        "oldText": {
                          "type": "string"
                        },
                        "oldHash": {
                          "type": "string",
                          "pattern": "^[a-fA-F0-9]{64}$"
                        },
                        "beforeContext": {
                          "type": "string"
                        },
                        "afterContext": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "startLine",
                        "endLine",
                        "replacement"
                      ],
                      "anyOf": [
                        {
                          "required": [
                            "oldText"
                          ]
                        },
                        {
                          "required": [
                            "oldHash"
                          ]
                        },
                        {
                          "required": [
                            "beforeContext"
                          ]
                        },
                        {
                          "required": [
                            "afterContext"
                          ]
                        }
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "path"
                ],
                "anyOf": [
                  {
                    "required": [
                      "content"
                    ]
                  },
                  {
                    "required": [
                      "hunks"
                    ]
                  }
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "edits"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "ghost_run_terminal_command",
        "displayName": "Ghost Run Terminal Command",
        "toolReferenceName": "ghost_run_terminal_command",
        "userDescription": "Run a shell command in the current workspace.",
        "modelDescription": "Runs a bash or PowerShell command in the current workspace and returns its output. Use only when the user asks for command execution or when it is needed to verify a change. Commands can change the system and require confirmation.",
        "canBeReferencedInPrompt": true,
        "icon": "$(terminal)",
        "when": "true",
        "inputSchema": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1,
              "description": "The bash or PowerShell command to run."
            },
            "cwd": {
              "type": "string",
              "description": "Optional absolute working directory inside the current workspace."
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "ghost_list_directory",
        "displayName": "Ghost List Directory",
        "toolReferenceName": "ghost_list_directory",
        "userDescription": "List files and directories in the current workspace.",
        "modelDescription": "Lists the file and directory hierarchy under a workspace directory. The path must be absolute and inside the current workspace. Use this to discover project structure before reading or editing files.",
        "canBeReferencedInPrompt": true,
        "icon": "$(folder)",
        "when": "true",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Absolute directory path to list. The path must be inside the current workspace."
            },
            "recursive": {
              "type": "boolean",
              "description": "Whether to include nested directories.",
              "default": false
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --out ghost-1.0.14.vsix",
    "test": "npm run compile && node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.8.1",
    "mocha": "^11.8.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/node-fetch": "^2.6.13",
    "node-fetch": "^2.7.0"
  }
}
